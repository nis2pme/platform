# Backend build context is the docker/ root (so frameworks/ can be baked in).
# Keep it lean — these are not needed inside the backend image.
frontend/
**/__pycache__/
*.pyc
*.pyo
.git/
.env

# The test suite is not part of the runtime image: nothing imports it at
# runtime, and a copy frozen at build time only grows more misleading as the
# code moves on.
backend/tests/
